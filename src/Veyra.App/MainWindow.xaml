<Window x:Class="Veyra.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VEYRA — Universal Media Player"
        Width="1280" Height="760"
        MinWidth="960" MinHeight="560"
        Background="{DynamicResource VeyraBackground}"
        Foreground="White"
        AllowDrop="True">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Text="VEYRA" FontSize="28" FontWeight="Bold" VerticalAlignment="Center" />
      <TextBlock Text="  Universal Media Player" FontSize="14" Opacity="0.6" VerticalAlignment="Center" />
      <Button x:Name="OpenButton" Content="Open media" Margin="20,0,0,0" Padding="18,8" Click="OpenButton_Click" DockPanel.Dock="Right" />
    </DockPanel>

    <Border Grid.Row="1" Background="Black" CornerRadius="12" BorderBrush="#242733" BorderThickness="1">
      <Grid>
        <MediaElement x:Name="NativePreview"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Manual"
                      Stretch="Uniform"
                      Visibility="Collapsed" />
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="VEYRA" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center" />
          <TextBlock Text="Drop a video here or choose Open media" Margin="0,8,0,0" Opacity="0.65" HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="2" Margin="0,14,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Slider x:Name="ProgressSlider" Minimum="0" Maximum="100" Value="0" />
      <DockPanel Grid.Row="1" Margin="0,8,0,0">
        <Button Content="⏮" Width="44" Click="Previous_Click" />
        <Button x:Name="PlayPauseButton" Content="▶" Width="54" Margin="6,0" Click="PlayPause_Click" />
        <Button Content="⏭" Width="44" Click="Next_Click" />
        <TextBlock x:Name="TimeText" Text="00:00 / 00:00" Margin="16,0" VerticalAlignment="Center" />
        <Button Content="Subtitles" Margin="12,0,0,0" Padding="12,5" />
        <Button Content="Audio" Margin="6,0,0,0" Padding="12,5" />
        <Button Content="Speed" Margin="6,0,0,0" Padding="12,5" />
        <Button Content="⚙" Width="44" Margin="6,0,0,0" DockPanel.Dock="Right" />
        <Button Content="⛶" Width="44" Margin="6,0,0,0" DockPanel.Dock="Right" />
      </DockPanel>
    </Grid>
  </Grid>
</Window>
