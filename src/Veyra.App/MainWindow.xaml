<Window x:Class="Veyra.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VEYRA — Universal Media Player"
        Width="1440" Height="820"
        MinWidth="1100" MinHeight="620"
        Background="{DynamicResource VeyraBackground}"
        Foreground="White"
        AllowDrop="True">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#1B1E27" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#2A2E39" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Margin" Value="2" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#0F1117" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#2A2E39" />
      <Setter Property="Padding" Value="10,7" />
    </Style>
  </Window.Resources>
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="390" /></Grid.ColumnDefinitions>
    <DockPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,14">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="VEYRA" FontSize="28" FontWeight="Bold" VerticalAlignment="Center" />
        <TextBlock Text="  Universal Media Player" FontSize="14" Opacity="0.6" VerticalAlignment="Center" />
      </StackPanel>
      <Button x:Name="OpenButton" Content="Open media" Margin="20,0,0,0" Padding="18,8" Click="OpenButton_Click" DockPanel.Dock="Right" />
    </DockPanel>
    <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,14,0">
      <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Border Grid.Row="0" Background="Black" CornerRadius="12" BorderBrush="#242733" BorderThickness="1">
        <Grid>
          <MediaElement x:Name="NativePreview" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="Uniform" Visibility="Collapsed" />
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="VEYRA" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center" />
            <TextBlock Text="Drop a video here or choose Open media" Margin="0,8,0,0" Opacity="0.65" HorizontalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1" Margin="0,14,0,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Slider x:Name="ProgressSlider" Minimum="0" Maximum="100" Value="0" ValueChanged="ProgressSlider_ValueChanged" PreviewMouseDown="ProgressSlider_MouseDown" PreviewMouseUp="ProgressSlider_MouseUp" />
        <DockPanel Grid.Row="1" Margin="0,8,0,0">
          <Button Content="⏮" Width="44" Click="Previous_Click" />
          <Button x:Name="PlayPauseButton" Content="▶" Width="54" Margin="6,0" Click="PlayPause_Click" />
          <Button Content="⏭" Width="44" Click="Next_Click" />
          <TextBlock x:Name="TimeText" Text="00:00 / 00:00" Margin="16,0" VerticalAlignment="Center" />
          <Button Content="Subtitles" Margin="12,0,0,0" Padding="12,5" />
          <Button Content="Audio" Margin="6,0,0,0" Padding="12,5" />
          <Button Content="Speed" Margin="6,0,0,0" Padding="12,5" />
          <Button Content="⚙" Width="44" Margin="6,0,0,0" DockPanel.Dock="Right" />
          <Button Content="⛶" Width="44" Margin="6,0,0,0" DockPanel.Dock="Right" />
        </DockPanel>
      </Grid>
    </Grid>
    <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource VeyraPanel}" CornerRadius="12" Padding="14" BorderBrush="#242733" BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Downloads" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="DownloadSummary" Text="0 active · 0 queued" FontSize="12" Opacity="0.6" Margin="0,2,0,0" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
            <TextBlock Text="Limit" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="11" Opacity="0.7" />
            <ComboBox x:Name="BandwidthLimitCombo" Width="112" Height="30" SelectionChanged="BandwidthLimitCombo_SelectionChanged" SelectedIndex="0">
              <ComboBoxItem Content="Unlimited" Tag="0" />
              <ComboBoxItem Content="256 KB/s" Tag="262144" />
              <ComboBoxItem Content="512 KB/s" Tag="524288" />
              <ComboBoxItem Content="1 MB/s" Tag="1048576" />
              <ComboBoxItem Content="2 MB/s" Tag="2097152" />
              <ComboBoxItem Content="5 MB/s" Tag="5242880" />
              <ComboBoxItem Content="10 MB/s" Tag="10485760" />
            </ComboBox>
            <Button Content="Open folder" Click="OpenDownloadsFolder_Click" />
          </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1" Margin="0,0,0,10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBox x:Name="DownloadUrlBox" Grid.Column="0" Height="38" VerticalContentAlignment="Center" ToolTip="Paste an HTTP(S) download URL" />
          <Button Grid.Column="1" Content="＋ Add" Height="38" Margin="6,0,0,0" Padding="14,6" Click="AddDownload_Click" />
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,0,0,8">
          <Button Content="Start all" Click="StartAllDownloads_Click" />
          <Button Content="Pause all" Click="PauseAllDownloads_Click" />
          <Button Content="Clear completed" Click="ClearCompleted_Click" DockPanel.Dock="Right" />
        </DockPanel>
        <ListBox x:Name="DownloadList" Grid.Row="3" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Background="#0F1117" BorderBrush="#242733" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}" />
                  <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding StatusText}" FontSize="11" Opacity="0.7" VerticalAlignment="Center" Margin="8,0,0,0" />
                  <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Height="6" Margin="0,8,0,6" Minimum="0" Maximum="100" Value="{Binding Progress}" />
                  <DockPanel Grid.Row="2" Grid.ColumnSpan="2">
                    <TextBlock Text="{Binding ProgressText}" FontSize="11" Opacity="0.7" />
                    <TextBlock Text=" · " FontSize="11" Opacity="0.4" />
                    <TextBlock Text="{Binding SpeedText}" FontSize="11" Opacity="0.7" />
                    <TextBlock Text=" · ETA " FontSize="11" Opacity="0.4" />
                    <TextBlock Text="{Binding EtaText}" FontSize="11" Opacity="0.7" />
                  </DockPanel>
                  <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="-2,6,0,0">
                    <Button Content="Pause" Click="PauseDownload_Click" Tag="{Binding}" />
                    <Button Content="Resume" Click="ResumeDownload_Click" Tag="{Binding}" />
                    <Button Content="Cancel" Click="CancelDownload_Click" Tag="{Binding}" />
                    <Button Content="Remove" Click="RemoveDownload_Click" Tag="{Binding}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>
  </Grid>
</Window>
